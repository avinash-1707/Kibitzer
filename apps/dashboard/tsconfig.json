{
  "//": "Self-contained TS config for the web dashboard (Unit I). Excluded from the root typecheck. Imports the frozen shared contract via `paths`.",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["vite/client"],
    "paths": {
      "@kibitzer/shared": ["../../packages/shared/src/index.ts"]
    }
  },
  "include": ["src"]
}
