# Kibitzer — environment. Copy to `.env` (Bun auto-loads it for the server) and fill in.
# `.env` is gitignored; never commit real keys.

# --- Server (packages/server) ---
# Port the backend listens on. Code default: 8787.
KIBITZER_PORT=8787
# SQLite file (bun:sqlite). Code default: kibitzer.sqlite. Use :memory: for a throwaway run.
KIBITZER_DB=kibitzer.sqlite

# --- Adapters (opencode / codex) ---
# Where adapters POST canonical events. Point at the SAME host as the server.
# Code default: http://localhost:8787/events. (Adapters run in OTHER repos — set it there.)
KIBITZER_ENDPOINT=http://localhost:8787/events

# --- OpenRouter (narration + devpost LLM) ---
# REQUIRED for real narration/wrap-up. Without it the pipeline falls back to templated
# text (feed still works, just not LLM-written). Get one at https://openrouter.ai.
OPENROUTER_API_KEY=sk-or-...
# REQUIRED (no code default) — the model IDs the server sends to OpenRouter.
OPENROUTER_NARRATION_MODEL=meta-llama/llama-3.1-8b-instruct
OPENROUTER_DEVPOST_MODEL=google/gemini-2.5-flash

# --- ElevenLabs (text-to-speech) ---
# REQUIRED for spoken audio. Without it TTS fails and the feed is text-only (by design).
# Free tier: 10k credits/mo. https://elevenlabs.io
ELEVENLABS_API_KEY=...
# Voice to synthesize with. Default below is ElevenLabs' "George" preset voice.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Voice model. Code default: eleven_v3_conversational (high quality, ~280ms — good for live
# narration). If your voice/plan rejects it, set eleven_multilingual_v2 (or eleven_flash_v2_5
# for lowest latency). https://elevenlabs.io/docs/overview/models
ELEVENLABS_MODEL_ID=eleven_v3_conversational
