{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["bun"],
    "paths": {
      "@kibitzer/shared": ["./packages/shared/src/index.ts"],
      "@kibitzer/shared/*": ["./packages/shared/src/*"]
    }
  },
  "exclude": ["node_modules", "apps/mobile", "apps/dashboard"]
}
